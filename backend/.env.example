# Supabase runtime connection. Use the Supavisor session pooler (port 5432)
# for this long-running NestJS backend.
DATABASE_URL="postgresql://prisma.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Prisma CLI/migrations connection. Prefer the direct database endpoint
# (port 5432) or the Supavisor session pooler when IPv6 is unavailable.
DIRECT_URL="postgresql://prisma:<password>@db.<project-ref>.supabase.co:5432/postgres"
