# PostgreSQL-compatible runtime connection. CockroachDB Cloud uses port 26257.
DATABASE_URL="postgresql://finwise:password@localhost:26257/finwise"

# Prisma CLI/migrations connection. Use the direct CockroachDB endpoint.
DIRECT_URL="postgresql://finwise:password@localhost:26257/finwise"

# Development accepts x-finwise-user-id or Bearer dev:<user-id>. Production
# requires an RSA key pair and issuer/audience for Finwise access JWTs.
FINWISE_DEV_AUTH=true
FINWISE_JWT_ISSUER="https://auth.finwise.local"
FINWISE_JWT_AUDIENCE="finwise-api"
FINWISE_JWT_KEY_ID="local-2026-08"
FINWISE_JWT_PRIVATE_KEY_BASE64=""
FINWISE_JWT_PUBLIC_KEY_BASE64=""
FINWISE_ACCESS_TTL_SECONDS=900
FINWISE_REFRESH_TTL_SECONDS=2592000

# Browser origins allowed to call the API with credentials.
FRONTEND_ORIGINS="http://localhost:3000"
