generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["finwise"]
}

enum WorkspaceKind {
  personal
  family
  class_fund
  other

  @@schema("finwise")
}

enum WorkspaceStatus {
  active
  archived

  @@schema("finwise")
}

enum MembershipStatus {
  invited
  active
  removed

  @@schema("finwise")
}

enum AccountKind {
  cash
  bank
  savings
  investment_cash
  loan_receivable
  liability
  system

  @@schema("finwise")
}

enum AccountStatus {
  active
  archived

  @@schema("finwise")
}

enum AccountVisibilityMode {
  workspace_default
  exclude_selected
  include_only
  owner_only

  @@schema("finwise")
}

enum JournalKind {
  opening_balance
  income
  expense
  transfer
  adjustment

  @@schema("finwise")
}

enum JournalStatus {
  posted
  voided

  @@schema("finwise")
}

enum EntryDirection {
  increase
  decrease

  @@schema("finwise")
}

enum TransactionAuditAction {
  created
  voided
  replaced

  @@schema("finwise")
}

model User {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName        String?            @map("display_name") @db.Text
  emailSnapshot      String?            @map("email_snapshot") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  externalIdentities ExternalIdentity[]
  memberships        WorkspaceMember[]

  @@map("users")
  @@schema("finwise")
}

model ExternalIdentity {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  providerIssuer  String   @map("provider_issuer") @db.Text
  providerSubject String   @map("provider_subject") @db.Text
  emailSnapshot   String?  @map("email_snapshot") @db.Text
  lastSeenAt      DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id])

  @@unique([providerIssuer, providerSubject])
  @@index([userId])
  @@map("external_identities")
  @@schema("finwise")
}

model Workspace {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String             @db.Text
  kind                 WorkspaceKind      @default(personal)
  defaultCurrency      String             @default("VND") @map("default_currency") @db.Char(3)
  timezone             String             @default("Asia/Ho_Chi_Minh") @db.Text
  status               WorkspaceStatus    @default(active)
  archivedAt           DateTime?          @map("archived_at") @db.Timestamptz(6)
  ownerMembershipId    String?            @unique @map("owner_membership_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships          WorkspaceMember[]
  ownerMembership      WorkspaceMember?   @relation("WorkspaceOwner", fields: [ownerMembershipId], references: [id])
  roles                Role[]
  accounts             FinancialAccount[]
  journalTransactions  JournalTransaction[]
  idempotencyKeys      IdempotencyKey[]
  transactionAudits    TransactionAudit[]

  @@map("workspaces")
  @@schema("finwise")
}

model WorkspaceMember {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String                @map("workspace_id") @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  status            MembershipStatus      @default(active)
  isOwner           Boolean               @default(false) @map("is_owner")
  joinedAt          DateTime?             @map("joined_at") @db.Timestamptz(6)
  removedAt         DateTime?             @map("removed_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id])
  user              User                  @relation(fields: [userId], references: [id])
  ownerOf           Workspace?            @relation("WorkspaceOwner")
  roleAssignments   RoleAssignment[]
  accountAccess     AccountMemberAccess[]
  createdAccounts   FinancialAccount[]    @relation("AccountCreator")
  createdJournals   JournalTransaction[]  @relation("JournalCreator")
  changedAudits     TransactionAudit[]    @relation("AuditActor")

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@map("workspace_members")
  @@schema("finwise")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  name        String           @db.Text
  protected   Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
  assignments RoleAssignment[]
  permissions RolePermission[]

  @@unique([workspaceId, name])
  @@map("roles")
  @@schema("finwise")
}

model RoleAssignment {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId   String          @map("member_id") @db.Uuid
  roleId     String          @map("role_id") @db.Uuid
  assignedAt DateTime        @default(now()) @map("assigned_at") @db.Timestamptz(6)
  member     WorkspaceMember @relation(fields: [memberId], references: [id])
  role       Role            @relation(fields: [roleId], references: [id])

  @@unique([memberId, roleId])
  @@map("role_assignments")
  @@schema("finwise")
}

model RolePermission {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  permission String @db.Text
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("role_permissions")
  @@schema("finwise")
}

model FinancialAccount {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String                @map("workspace_id") @db.Uuid
  name              String                @db.Text
  kind              AccountKind
  currencyCode      String                @default("VND") @map("currency_code") @db.Char(3)
  status            AccountStatus         @default(active)
  visibilityMode    AccountVisibilityMode @default(workspace_default) @map("visibility_mode")
  isSystem          Boolean               @default(false) @map("is_system")
  balanceMinor      BigInt                @default(0) @map("balance_minor")
  createdByMemberId String                @map("created_by_member_id") @db.Uuid
  archivedAt        DateTime?             @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id])
  createdByMember   WorkspaceMember       @relation("AccountCreator", fields: [createdByMemberId], references: [id])
  entries           JournalEntry[]
  memberAccess      AccountMemberAccess[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status, isSystem])
  @@map("financial_accounts")
  @@schema("finwise")
}

model AccountMemberAccess {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String           @map("account_id") @db.Uuid
  memberId  String           @map("member_id") @db.Uuid
  allowed   Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([accountId, memberId])
  @@map("account_member_access")
  @@schema("finwise")
}

model JournalTransaction {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String              @map("workspace_id") @db.Uuid
  kind               JournalKind
  status             JournalStatus       @default(posted)
  amountMinor        BigInt              @map("amount_minor")
  currencyCode       String              @default("VND") @map("currency_code") @db.Char(3)
  effectiveDate      DateTime            @map("effective_date") @db.Date
  recordedAt         DateTime            @default(now()) @map("recorded_at") @db.Timestamptz(6)
  description        String?             @db.Text
  createdByMemberId  String              @map("created_by_member_id") @db.Uuid
  reversalOfId       String?             @map("reversal_of_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id])
  createdByMember    WorkspaceMember     @relation("JournalCreator", fields: [createdByMemberId], references: [id])
  entries            JournalEntry[]
  reversalOf         JournalTransaction? @relation("ReversalChain", fields: [reversalOfId], references: [id])
  reversals          JournalTransaction[] @relation("ReversalChain")
  idempotencyKeys    IdempotencyKey[]
  audits             TransactionAudit[]

  @@unique([workspaceId, id])
  @@index([workspaceId, effectiveDate(sort: Desc)])
  @@index([workspaceId, status])
  @@map("journal_transactions")
  @@schema("finwise")
}

model JournalEntry {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String             @map("transaction_id") @db.Uuid
  accountId     String             @map("account_id") @db.Uuid
  amountMinor   BigInt             @map("amount_minor")
  direction     EntryDirection
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  transaction   JournalTransaction @relation(fields: [transactionId], references: [id])
  account       FinancialAccount   @relation(fields: [accountId], references: [id])

  @@unique([transactionId, accountId, direction])
  @@index([accountId, createdAt])
  @@map("journal_entries")
  @@schema("finwise")
}

model TransactionAudit {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String              @map("workspace_id") @db.Uuid
  transactionId String              @map("transaction_id") @db.Uuid
  actorMemberId String              @map("actor_member_id") @db.Uuid
  action        TransactionAuditAction
  details       Json?
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace     Workspace           @relation(fields: [workspaceId], references: [id])
  transaction   JournalTransaction  @relation(fields: [transactionId], references: [id])
  actor         WorkspaceMember     @relation("AuditActor", fields: [actorMemberId], references: [id])

  @@index([workspaceId, transactionId, createdAt])
  @@map("transaction_audits")
  @@schema("finwise")
}

model IdempotencyKey {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String              @map("workspace_id") @db.Uuid
  key           String              @db.VarChar(255)
  operation     String              @db.Text
  requestHash   String              @map("request_hash") @db.Char(64)
  response      Json
  transactionId String?             @map("transaction_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace     Workspace           @relation(fields: [workspaceId], references: [id])
  transaction   JournalTransaction? @relation(fields: [transactionId], references: [id])

  @@unique([workspaceId, key])
  @@map("idempotency_keys")
  @@schema("finwise")
}
