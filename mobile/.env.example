# Use the host machine's LAN address for a physical device or Android emulator.
# Do not use localhost unless the API is running inside the device runtime.
EXPO_PUBLIC_FINWISE_API_URL="http://192.168.1.10:3001"
# Development-only: allow local HTTP in generated Android/iOS projects.
# Keep unset/false for preview and production; those builds must use HTTPS.
FINWISE_ALLOW_HTTP="false"
