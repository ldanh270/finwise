{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go --lan",
    "start:go:offline": "expo start --go --offline",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.tsx\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.tsx\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:native-config": "node --test plugins/with-finwise-network-security.test.cjs"
  },
  "dependencies": {
    "@finwise/api-client": "workspace:*",
    "@tanstack/react-query": "^5.66.0",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/react": "~19.1.17",
    "jest": "^29.7.0",
    "metro-runtime": "0.83.3",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.3"
  }
}
