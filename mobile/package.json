{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.tsx\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.tsx\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:native-config": "node --test plugins/with-finwise-network-security.test.cjs"
  },
  "dependencies": {
    "@finwise/api-client": "workspace:*",
    "@tanstack/react-query": "^5.66.0",
    "expo": "~53.0.0",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-linking": "~7.1.7",
    "expo-local-authentication": "~16.0.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.3",
    "expo-sharing": "~13.1.5",
    "expo-sqlite": "~15.2.14",
    "expo-system-ui": "~5.0.11",
    "react": "19.0.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/react": "~19.0.10",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "~5.8.3"
  }
}
