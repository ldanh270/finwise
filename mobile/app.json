{
  "expo": {
    "name": "Finwise",
    "slug": "finwise",
    "scheme": "finwise",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-secure-store",
      "expo-dev-client",
      "./plugins/with-finwise-network-security.cjs",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Finwise to use Face ID to unlock your private workspace."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.finwise.mobile"
    },
    "android": {
      "package": "com.finwise.mobile",
      "edgeToEdgeEnabled": true
    }
  }
}
