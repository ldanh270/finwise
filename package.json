{
  "name": "finwise",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "i:all": "pnpm install:backend && pnpm install:frontend && pnpm db:generate",
    "install:backend": "pnpm --dir backend install --frozen-lockfile",
    "install:frontend": "pnpm --dir frontend install --frozen-lockfile",
    "dev": "node scripts/run-apps.mjs dev",
    "dev:backend": "pnpm --dir backend start:dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "build": "pnpm build:backend && pnpm build:frontend",
    "build:backend": "pnpm --dir backend build",
    "build:frontend": "pnpm --dir frontend build",
    "start": "node scripts/run-apps.mjs start",
    "start:backend": "pnpm --dir backend start:prod",
    "start:frontend": "pnpm --dir frontend start",
    "lint": "pnpm lint:backend && pnpm lint:frontend",
    "lint:backend": "pnpm --dir backend lint",
    "lint:frontend": "pnpm --dir frontend lint",
    "format:backend": "pnpm --dir backend format",
    "typecheck": "pnpm typecheck:backend && pnpm typecheck:frontend",
    "typecheck:backend": "pnpm --dir backend typecheck",
    "typecheck:frontend": "pnpm --dir frontend typecheck",
    "test": "pnpm test:backend",
    "test:backend": "pnpm --dir backend exec jest --runInBand",
    "test:e2e": "pnpm --dir backend exec jest --config ./test/jest-e2e.json --runInBand",
    "test:cov": "pnpm --dir backend test:cov",
    "db:generate": "pnpm --dir backend db:generate",
    "db:validate": "pnpm --dir backend db:validate",
    "db:format": "pnpm --dir backend db:format",
    "db:pull": "pnpm --dir backend db:pull",
    "db:migrate": "pnpm --dir backend db:migrate",
    "db:migrate:create": "pnpm --dir backend db:migrate:create",
    "db:deploy": "pnpm --dir backend db:deploy",
    "db:migrate:deploy": "pnpm db:deploy",
    "db:status": "pnpm --dir backend db:status",
    "db:seed": "pnpm --dir backend db:seed",
    "db:reset": "pnpm --dir backend db:reset",
    "db:studio": "pnpm --dir backend db:studio"
  }
}
