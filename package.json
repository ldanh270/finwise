{
  "name": "finwise",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "setup": "pnpm install && pnpm db:generate",
    "i:all": "pnpm setup",
    "install:all": "pnpm install",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "server:install": "npm --prefix backend install",
    "server:build": "npm run build:backend",
    "server:start": "npm run start:backend",
    "server:db:deploy": "npm run db:deploy",
    "server:test": "npm run test:backend",
    "server:typecheck": "npm run typecheck:backend",
    "dev": "node scripts/run-apps.mjs dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "mobile:prebuild": "pnpm --filter mobile prebuild",
    "start": "node scripts/run-apps.mjs start",
    "start:backend": "npm --prefix backend run start:prod",
    "start:frontend": "npm --prefix frontend run start",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "npm --prefix backend run lint",
    "lint:frontend": "npm --prefix frontend run lint",
    "format:backend": "npm --prefix backend run format",
    "format:check": "npm run format:check:server && npm run format:check:mobile",
    "format:check:server": "npm run format:check:backend && npm run format:check:frontend",
    "format:check:backend": "npm --prefix backend run format:check",
    "format:check:frontend": "npm --prefix frontend run format:check",
    "format:check:mobile": "pnpm --filter mobile format:check",
    "contracts:check": "node scripts/check-openapi.mjs",
    "typecheck": "npm run typecheck:server && pnpm typecheck:api-client && pnpm typecheck:mobile",
    "typecheck:api-client": "pnpm --filter @finwise/api-client typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck:server": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:mobile": "pnpm --filter mobile typecheck",
    "test": "npm run test:backend",
    "test:dev-runner": "node --test scripts/process-tree.test.mjs scripts/port-preflight.test.mjs scripts/package-manager.test.mjs",
    "test:backend": "npm --prefix backend run test -- --runInBand",
    "test:e2e": "npm --prefix backend run test:e2e -- --runInBand",
    "test:mobile": "pnpm --filter mobile test && pnpm --filter mobile test:native-config",
    "test:cov": "npm --prefix backend run test:cov",
    "db:generate": "npm --prefix backend run db:generate",
    "db:validate": "npm --prefix backend run db:validate",
    "db:format": "npm --prefix backend run db:format",
    "db:pull": "npm --prefix backend run db:pull",
    "db:migrate": "npm --prefix backend run db:migrate --",
    "db:migrate:create": "npm --prefix backend run db:migrate:create --",
    "db:deploy": "npm --prefix backend run db:deploy",
    "db:deploy:prisma": "npm --prefix backend run db:deploy:prisma",
    "db:migrate:deploy": "npm run db:deploy",
    "db:status": "npm --prefix backend run db:status",
    "db:preflight": "node scripts/database-preflight.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:release-preflight": "node --test scripts/release-preflight.test.mjs",
    "db:seed": "npm --prefix backend run db:seed",
    "db:reset": "npm --prefix backend run db:reset",
    "db:studio": "npm --prefix backend run db:studio"
  }
}
